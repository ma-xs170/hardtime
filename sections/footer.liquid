<footer class="footer footer--min">
  <div class="container footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    {%- for block in section.blocks -%}
      <nav class="footer__links" {{ block.shopify_attributes }} aria-label="{{ block.settings.menu }}">
        {%- for link in linklists[block.settings.menu].links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
      </nav>
    {%- endfor -%}
    <span class="footer__social">
      {%- if section.settings.instagram != blank -%}
        <a href="{{ section.settings.instagram }}" aria-label="Instagram" rel="noopener" target="_blank"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
      {%- endif -%}
      {%- if section.settings.tiktok != blank -%}
        <a href="{{ section.settings.tiktok }}" aria-label="TikTok" rel="noopener" target="_blank"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v12a4 4 0 1 1-4-4"/><path d="M14 3c.3 2.6 2 4.4 5 4.6"/></svg></a>
      {%- endif -%}
    </span>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "url", "id": "instagram", "label": "Instagram" },
    { "type": "url", "id": "tiktok", "label": "TikTok" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Liens",
      "settings": [
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [{ "type": "menu" }]
  }
}
{% endschema %}
