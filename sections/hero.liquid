<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      <h1 class="hero__title">{{ section.settings.title }}</h1>
      {%- if section.settings.text != blank -%}<p class="hero__text">{{ section.settings.text }}</p>{%- endif -%}
      <div class="hero__buttons">
        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn--ghost" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero__panel">
      {%- if section.settings.image -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag:
          loading: 'eager', fetchpriority: 'high',
          widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', class: 'hero__img' }}
      {%- else -%}
        <svg class="dial" viewBox="0 0 200 200" role="img" aria-label="Horloge indiquant l'heure locale" data-dial>
          <circle cx="100" cy="100" r="96" fill="none" stroke="currentColor" stroke-width="1.5"/>
          {%- for i in (0..59) -%}
            {%- assign deg = i | times: 6 -%}
            {%- assign rest = i | modulo: 5 -%}
            {%- if rest == 0 -%}
              <line x1="100" y1="10" x2="100" y2="24" stroke="currentColor" stroke-width="3" transform="rotate({{ deg }} 100 100)"/>
            {%- else -%}
              <line x1="100" y1="10" x2="100" y2="15" stroke="currentColor" stroke-width="1" opacity=".5" transform="rotate({{ deg }} 100 100)"/>
            {%- endif -%}
          {%- endfor -%}
          <text x="100" y="62" text-anchor="middle" font-size="9" fill="currentColor" letter-spacing="1.5">{{ shop.name | downcase }}</text>
          <line data-hand="h" x1="100" y1="100" x2="100" y2="54" stroke="currentColor" stroke-width="5" stroke-linecap="butt"/>
          <line data-hand="m" x1="100" y1="100" x2="100" y2="30" stroke="currentColor" stroke-width="3" stroke-linecap="butt"/>
          <g data-hand="s">
            <line x1="100" y1="116" x2="100" y2="22" stroke="var(--color-accent-signal)" stroke-width="1.5"/>
          </g>
          <circle cx="100" cy="100" r="4" fill="var(--color-accent-signal)"/>
        </svg>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image (remplace le cadran)" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Il est temps de s'équiper." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Montres et vêtements de seconde main, choisis un par un et vendus à leur juste prix." },
    { "type": "text", "id": "button_label", "label": "Bouton 1", "default": "Voir les montres" },
    { "type": "url", "id": "button_link", "label": "Lien bouton 1" },
    { "type": "text", "id": "button2_label", "label": "Bouton 2", "default": "Voir les vêtements" },
    { "type": "url", "id": "button2_link", "label": "Lien bouton 2" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
