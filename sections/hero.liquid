<section class="hero hero--{{ section.settings.height }}">
  <div class="hero__media">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        loading: 'eager', fetchpriority: 'high',
        widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', class: 'hero__img' }}
    {%- else -%}
      {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__img placeholder' }}
    {%- endif -%}
  </div>
  <div class="container hero__content hero__content--{{ section.settings.align }}">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="hero__title">{{ section.settings.title }}</h1>
    {%- if section.settings.text != blank -%}<p class="hero__text">{{ section.settings.text }}</p>{%- endif -%}
    <div class="hero__buttons">
      {%- if section.settings.button_label != blank -%}
        <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a class="btn btn--ghost" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Nouvelle sélection" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Pièces rares. Prix justes." },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Vêtements et montres authentifiés, prêts à être portés." },
    { "type": "text", "id": "button_label", "label": "Bouton 1", "default": "Voir les vêtements" },
    { "type": "url", "id": "button_link", "label": "Lien bouton 1" },
    { "type": "text", "id": "button2_label", "label": "Bouton 2", "default": "Voir les montres" },
    { "type": "url", "id": "button2_link", "label": "Lien bouton 2" },
    { "type": "select", "id": "align", "label": "Alignement", "default": "left", "options": [
      { "value": "left", "label": "Gauche" }, { "value": "center", "label": "Centre" }
    ]},
    { "type": "select", "id": "height", "label": "Hauteur", "default": "large", "options": [
      { "value": "medium", "label": "Moyenne" }, { "value": "large", "label": "Grande" }
    ]}
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
