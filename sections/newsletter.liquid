<section class="section section--surface newsletter">
  <div class="container newsletter__inner">
    <h2 class="section__title">{{ section.settings.title }}</h2>
    {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p>{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <input type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required autocomplete="email" aria-label="{{ 'newsletter.email' | t }}">
        <button class="btn" type="submit">{{ 'newsletter.subscribe' | t }}</button>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Ne ratez aucun arrivage" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Accès anticipé aux nouvelles pièces." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
