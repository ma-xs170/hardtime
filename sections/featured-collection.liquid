<section class="section">
  <div class="container">
    <div class="section__head">
      <h2 class="section__title">{{ section.settings.title }}</h2>
      {%- if section.settings.collection != blank -%}
        <a class="link" href="{{ section.settings.collection.url }}">{{ 'general.view_all' | t }}</a>
      {%- endif -%}
    </div>

    <div class="grid grid--{{ section.settings.columns }}">
      {%- for product in section.settings.collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="card"><div class="card__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}</div></div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection mise en avant",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Derniers arrivages" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Produits", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "columns", "label": "Colonnes (desktop)", "default": "4", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ]}
  ],
  "presets": [{ "name": "Collection mise en avant" }]
}
{% endschema %}
