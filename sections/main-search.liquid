<section class="section">
  <div class="container">
    <h1 class="page-head__title">{{ 'search.title' | t }}</h1>
    <form class="searchbar" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" autofocus>
      <button class="btn" type="submit">{{ 'general.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results_count == 0 -%}
          <p>{{ 'search.no_results' | t: terms: search.terms }}</p>
        {%- else -%}
          <div class="grid grid--4">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}{%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">←</a>{%- endif -%}
              <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">→</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Recherche", "settings": [] }
{% endschema %}
