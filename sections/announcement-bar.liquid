<div class="announcement">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
    <span class="announcement__inner">{% render 'icon', name: 'truck', size: 16 %}<span>{{ section.settings.text }}</span></span>
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</div>

{% schema %}
{
  "name": "Barre d'annonce",
  "settings": [
    { "type": "text", "id": "text", "label": "Texte", "default": "Livraison partout en Guadeloupe" },
    { "type": "url", "id": "link", "label": "Lien" }
  ],
  "presets": [{ "name": "Barre d'annonce" }]
}
{% endschema %}
