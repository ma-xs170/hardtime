<section class="section">
  <div class="container">
    <header class="page-head">
      <h1 class="page-head__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}<div class="rte muted">{{ collection.description }}</div>{%- endif -%}
    </header>

    <div class="toolbar">
      <span class="muted">{{ collection.products_count }} {{ 'collection.items' | t }}</span>
      {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
      <label class="toolbar__sort">
        <span>{{ 'collection.sort_by' | t }}</span>
        <select data-sort>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>
    </div>

    <div class="layout-filters">
      {%- if collection.filters.size > 0 -%}
        <form class="filters" data-filters>
          {%- for filter in collection.filters -%}
            <details class="filter" open>
              <summary>{{ filter.label }}</summary>
              {%- case filter.type -%}
                {%- when 'list' -%}
                  <ul>
                    {%- for v in filter.values -%}
                      <li>
                        <label>
                          <input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}" {% if v.active %}checked{% endif %} {% if v.count == 0 and v.active == false %}disabled{% endif %}>
                          {{ v.label }} <span class="muted">({{ v.count }})</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- when 'price_range' -%}
                  <div class="filter__price">
                    <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="0" min="0">
                    <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="{{ filter.range_max | money_without_currency | split: '.' | first }}" min="0">
                  </div>
              {%- endcase -%}
            </details>
          {%- endfor -%}
          <noscript><button class="btn" type="submit">{{ 'collection.filter' | t }}</button></noscript>
        </form>
      {%- endif -%}

      <div>
        {%- paginate collection.products by 24 -%}
          <div class="grid grid--3">
            {%- for product in collection.products -%}
              {% render 'product-card', product: product, eager: forloop.index0 < 4 %}
            {%- else -%}
              <p>{{ 'collection.empty' | t }}</p>
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">←</a>{%- endif -%}
              <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">→</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
