<section class="section section--surface">
  <div class="container trust">
    {%- for block in section.blocks -%}
      <div class="trust__item" {{ block.shopify_attributes }}>
        <h3 class="trust__title">{{ block.settings.title }}</h3>
        <p class="muted">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Réassurance",
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "Authenticité garantie" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Chaque pièce est vérifiée par nos soins avant expédition." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Réassurance",
    "blocks": [
      { "type": "item", "settings": { "title": "Authenticité garantie", "text": "Chaque pièce est vérifiée avant expédition." } },
      { "type": "item", "settings": { "title": "État détaillé", "text": "Photos réelles et grade d'état sur chaque article." } },
      { "type": "item", "settings": { "title": "Livraison assurée", "text": "Colis suivi et assuré, emballage soigné." } },
      { "type": "item", "settings": { "title": "Retours 14 jours", "text": "Un doute ? Renvoyez, remboursé." } }
    ]
  }]
}
{% endschema %}
