<section class="section">
  <div class="container">
    <h1 class="page-head__title">{{ 'general.view_all' | t }}</h1>
    <div class="tiles">
      {%- for collection in collections -%}
        <a class="tile" href="{{ collection.url }}">
          {%- if collection.image -%}
            {{ collection.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'tile__img' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'tile__img placeholder' }}
          {%- endif -%}
          <span class="tile__label">{{ collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "Liste des collections", "settings": [] }
{% endschema %}
